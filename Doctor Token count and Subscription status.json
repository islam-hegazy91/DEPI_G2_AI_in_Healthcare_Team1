        "mode": "expression",
        "output": "=\n{{\n  Number($json.sessions_available) >= 10 ? 0 :\n  Number($json.sessions_available) >= 2 ? 1 :\n  Number($json.sessions_available) === 1 ? 2 :\n  Number($json.sessions_available) === 0 ? 3 :\n  -1\n}}\n"
